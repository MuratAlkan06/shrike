<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.shrike</groupId>
    <artifactId>shrike-parent</artifactId>
    <version>1.1.0</version>
  </parent>

  <artifactId>shrike-admin</artifactId>

  <name>Shrike Admin</name>
  <description>Admin and observability facade. The only module allowed to use Spring.</description>

  <properties>
    <spring-boot.version>3.5.16</spring-boot.version>
    <jackson-bom.version>2.21.5</jackson-bom.version>
    <tomcat-embed.version>10.1.57</tomcat-embed.version>
  </properties>

  <!-- Order is the whole mechanism here. The Spring BOM is imported rather than inherited, and a
       <properties> override of the kind spring-boot-starter-parent documents does nothing to an
       imported BOM: the version it pins is the one that wins. What does win is an earlier entry in
       this same section, because the first declaration of a coordinate is the one Maven keeps. So
       everything this module means to move off what Spring Boot 3.5.16 pins is declared above the
       import, and nothing below it can pull those back. DESIGN.md carries why this line of Spring
       is being patched by hand at all. -->
  <dependencyManagement>
    <dependencies>
      <!-- The reactor's parent already imports this, and the Spring BOM imported below would
           otherwise override it for this module alone: JUnit 5.12.2 here against 5.14.4 in the two
           modules that do not name Spring. Tests in one build run one version. -->
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- Three moderate deserialization advisories against what Boot 3.5.16 pins. None of them is
           reachable from this facade — it answers JSON and never reads any — so this is hygiene
           rather than a fix, and it is a BOM import so that every jackson artifact on the path
           moves together. -->
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson-bom.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- The embedded server, ahead of the BOM that pins an older one. All three artifacts carry
           the same version on purpose: they are one release of Tomcat, and a build that mixed them
           would be running a combination Tomcat never tested. -->
      <dependency>
        <groupId>org.apache.tomcat.embed</groupId>
        <artifactId>tomcat-embed-core</artifactId>
        <version>${tomcat-embed.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.tomcat.embed</groupId>
        <artifactId>tomcat-embed-el</artifactId>
        <version>${tomcat-embed.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.tomcat.embed</groupId>
        <artifactId>tomcat-embed-websocket</artifactId>
        <version>${tomcat-embed.version}</version>
      </dependency>

      <!-- Imported here rather than inherited from spring-boot-starter-parent so the
           reactor keeps its own parent and Spring stays scoped to this module. -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>io.shrike</groupId>
      <artifactId>shrike-clients</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Versionless on purpose: the BOM imported above is what pins it, and it is the only Spring
         coordinate in this build. It brings the embedded server, the request mapping, and the JSON
         codec this facade answers with. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The broker process harness, published by shrike-clients as a second artifact so that this
         module's *IT classes start a real broker rather than a copy of one. -->
    <dependency>
      <groupId>io.shrike</groupId>
      <artifactId>shrike-clients</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <!-- Importing the BOM brings no plugin management, so the version is pinned here. -->
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!-- Repackages the module jar into one that carries its dependencies and can be started with
           java -jar. The packaging slice launches this facade that way. -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>repackage-as-a-runnable-jar</id>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- The *IT classes start a broker as a separate operating-system process and the facade in
           this one, so they run in the integration-test phase against the built artifacts rather than
           beside the unit tests. Surefire ignores an *IT by default; verify is what fails the build
           when one does. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <id>run-integration-tests</id>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <!-- Without this the forked JVM's java.class.path is a manifest-only jar, and the tests
               launch child JVMs with the classpath they were given. -->
          <useManifestOnlyJar>false</useManifestOnlyJar>
          <!-- Failsafe would otherwise test the module's jar, and by the time it runs, repackage has
               turned that jar into a runnable one whose classes live under BOOT-INF/classes where no
               plain classloader looks. This is what Spring Boot's own documentation prescribes for a
               build that does not inherit from spring-boot-starter-parent, which this one does not. -->
          <classesDirectory>${project.build.outputDirectory}</classesDirectory>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
