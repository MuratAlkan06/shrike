<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.shrike</groupId>
    <artifactId>shrike-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>shrike-clients</artifactId>

  <name>Shrike Clients</name>
  <description>Producer and consumer clients, built on the protocol surface of shrike-core.</description>

  <dependencies>
    <dependency>
      <groupId>io.shrike</groupId>
      <artifactId>shrike-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- The *IT classes start real brokers, producers, and consumers as separate operating-system
           processes, so they run in the integration-test phase against the built artifacts rather
           than beside the unit tests. Surefire ignores an *IT by default; verify is what fails the
           build when one does. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <id>run-integration-tests</id>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <!-- Without this the forked JVM's java.class.path is a manifest-only jar, and the tests
               launch child JVMs with the classpath they were given. -->
          <useManifestOnlyJar>false</useManifestOnlyJar>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
