<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.shrike</groupId>
    <artifactId>shrike-parent</artifactId>
    <version>1.5.0</version>
  </parent>

  <artifactId>shrike-core</artifactId>

  <name>Shrike Core</name>
  <description>Broker engine: commit log, protocol, and networking. Depends on the JDK alone.</description>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The benchmark harness, and test-scoped like every other dependency this module is allowed:
         the benchmarks live under src/test/java, nothing in src/main names JMH, and the enforcer
         rule below is what keeps that true rather than this comment. -->
    <dependency>
      <groupId>org.openjdk.jmh</groupId>
      <artifactId>jmh-core</artifactId>
      <version>${jmh.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- JMH generates a runner class and a BenchmarkList entry per @Benchmark method, and it does
           it from an annotation processor. The path is configured on the test compilation alone —
           this plugin has one `annotationProcessorPaths` parameter per mojo rather than a test-only
           one, so scoping it to the `default-testCompile` execution is what keeps the processor away
           from src/main. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <executions>
          <execution>
            <id>default-testCompile</id>
            <configuration>
              <annotationProcessorPaths>
                <path>
                  <groupId>org.openjdk.jmh</groupId>
                  <artifactId>jmh-generator-annprocess</artifactId>
                  <version>${jmh.version}</version>
                </path>
              </annotationProcessorPaths>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- The generated JMH runners are named `<benchmark>_jmhTest`, which surefire's default
           `**/*Test.java` include matches. Excluding the bench package keeps the unit-test run to
           the tests, and it is why `mvn verify` compiles the benchmarks without running one. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>**/bench/**</exclude>
          </excludes>
        </configuration>
      </plugin>

      <!-- Declared here, not in the reactor, so the ban applies to core alone
           and leaves clients and admin free to depend on core. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-core-depends-on-the-jdk-only</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>*</exclude>
                  </excludes>
                  <includes>
                    <include>*:*:*:*:test</include>
                  </includes>
                  <message>shrike-core must depend on the JDK alone; only test-scoped dependencies are allowed.</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <!-- The benchmarks are compiled by every build and run by none of it. `mvn verify` — which is what
       CI runs — never activates this profile, so a benchmark cannot make the build slow or flaky,
       and it still cannot rot: it is test-compiled like every other class under src/test/java.
       Running the suite is four commands, one per execution below, and they are the commands the
       README documents. Each carries its own JMH arguments and its own result file, so what produced
       a published number is in this file rather than in somebody's shell history. -->
  <profiles>
    <profile>
      <id>bench</id>
      <properties>
        <!-- Where the raw JMH results land. They are committed as they were written, because a number
             in the README is worth what the file behind it is worth. -->
        <bench.results.directory>${project.basedir}/../docs/bench</bench.results.directory>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <configuration>
              <!-- `java` rather than a path, so the jdk toolchain this reactor already requires is
                   what runs the harness — the same JDK 21 the tests run on, rather than whichever
                   JVM happened to launch Maven. JMH's forks inherit it from there, and the JSON
                   records which JVM it was. -->
              <executable>java</executable>
              <classpathScope>test</classpathScope>
            </configuration>
            <executions>
              <!-- Every benchmark, at the iteration counts its own annotations state. -->
              <execution>
                <id>suite</id>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <arguments>
                    <argument>-classpath</argument>
                    <classpath/>
                    <argument>org.openjdk.jmh.Main</argument>
                    <argument>-rf</argument>
                    <argument>json</argument>
                    <argument>-rff</argument>
                    <argument>${bench.results.directory}/v1.6-flush-and-fetch.json</argument>
                  </arguments>
                </configuration>
              </execution>

              <!-- The sampled per-record arm again, over thirty two-second iterations rather than five
                   one-second ones. At around four milliseconds an append the suite above can only time
                   a couple of thousand invocations of it, and a p99 read off that few is a thin number;
                   this is what the published tail stands on. The counts land in the result file. -->
              <execution>
                <id>per-record-tail</id>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <arguments>
                    <argument>-classpath</argument>
                    <classpath/>
                    <argument>org.openjdk.jmh.Main</argument>
                    <argument>io.shrike.core.bench.FlushPolicyBenchmark.appendOneProduceServiceTime</argument>
                    <!-- The parameter is joined to its flag rather than written as two arguments, and
                         that is load-bearing: `<argument>flushMode=PER_RECORD</argument>` on its own is
                         dropped on the way to the command line, which leaves JMH reading the next flag
                         as the parameter and refusing to start. JMH takes `-pname=value` as one token,
                         so the value cannot go missing. -->
                    <argument>-pflushMode=PER_RECORD</argument>
                    <argument>-i</argument>
                    <argument>30</argument>
                    <argument>-r</argument>
                    <argument>2s</argument>
                    <argument>-rf</argument>
                    <argument>json</argument>
                    <argument>-rff</argument>
                    <argument>${bench.results.directory}/v1.6-per-record-tail.json</argument>
                  </arguments>
                </configuration>
              </execution>

              <!-- One long per-record throughput trial, four forks of twenty three-second iterations,
                   which exists to answer whether the two forks that disagreed in the Slice 5 run were
                   the mode or the machine. Eighty measured iterations across four JVMs is enough to
                   see a mode that is bimodal and enough to see a machine that is not. -->
              <execution>
                <id>per-record-long-trial</id>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <arguments>
                    <argument>-classpath</argument>
                    <classpath/>
                    <argument>org.openjdk.jmh.Main</argument>
                    <argument>io.shrike.core.bench.FlushPolicyBenchmark.appendOneProduceThroughput</argument>
                    <argument>-pflushMode=PER_RECORD</argument>
                    <argument>-pbatchRecords=1</argument>
                    <argument>-f</argument>
                    <argument>4</argument>
                    <argument>-i</argument>
                    <argument>20</argument>
                    <argument>-r</argument>
                    <argument>3s</argument>
                    <argument>-rf</argument>
                    <argument>json</argument>
                    <argument>-rff</argument>
                    <argument>${bench.results.directory}/v1.6-per-record-long-trial.json</argument>
                  </arguments>
                </configuration>
              </execution>

              <!-- The fetch paths again under JMH's allocation profiler, which is what says how much of
                   the buffered path's cost is the mebibyte it allocates per fetch. Same iterations as
                   the suite; the profiler is the only difference, and its results land in the same
                   result file beside the scores. -->
              <execution>
                <id>fetch-allocation</id>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <arguments>
                    <argument>-classpath</argument>
                    <classpath/>
                    <argument>org.openjdk.jmh.Main</argument>
                    <argument>io.shrike.core.bench.FetchPathBenchmark</argument>
                    <argument>-prof</argument>
                    <argument>gc</argument>
                    <argument>-rf</argument>
                    <argument>json</argument>
                    <argument>-rff</argument>
                    <argument>${bench.results.directory}/v1.6-fetch-allocation.json</argument>
                  </arguments>
                </configuration>
              </execution>

            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
